# Copy to .env and fill in. `docker compose up --build` reads this file.
# Values marked REQUIRED have no safe default. The README explains where each one comes from.

# ---------------------------------------------------------------- database
POSTGRES_USER=crypton
POSTGRES_DB=crypton
POSTGRES_PASSWORD=                 # REQUIRED: any strong password you choose

# ---------------------------------------------------------------- application
# Development keeps the simulated blockchain, simulated payments and the API reference page.
# Switch to Production once the live keys below are filled in.
ASPNETCORE_ENVIRONMENT=Development
FRONTEND_BASE_URL=http://localhost:4200
API_BASE_URL=http://localhost:4200
JWT_REFRESH_COOKIE_SECURE=false    # true once the site is served over HTTPS

# REQUIRED. Generate both with:  dotnet run --project tools/Crypton.KeyTool -- secrets
JWT_SIGNING_KEY=
KYC_ID_HASH_KEY=

# First staff account, created on start-up when both are set. Sign in, enable 2FA, change the password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=false               # true adds two demo customers and balances (never in production)

# ---------------------------------------------------------------- email
# Defaults point at the Mailpit container. For real email, use your provider's SMTP details.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None                 # None | StartTls | SslOnConnect
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com

# ---------------------------------------------------------------- prices
PRICING_PROVIDER=Simulated         # CoinGecko for live prices
COINGECKO_API_KEY=                 # Demo or Pro key from coingecko.com

# ---------------------------------------------------------------- blockchain
BLOCKCHAIN_MODE=Simulated          # Live to talk to real networks
BITCOIN_NETWORK=testnet4           # testnet4 | main
BITCOIN_API_BASE_URL=https://mempool.space/testnet4/api
BITCOIN_ACCOUNT_XPUB=              # watch-only account key from the key tool
BITCOIN_HOT_WALLET_WIF=            # withdrawal wallet key from the key tool
ETHEREUM_RPC_URL=                  # e.g. an Alchemy or Infura HTTPS endpoint
ETHEREUM_CHAIN_ID=11155111         # 11155111 Sepolia, 1 mainnet
ETHEREUM_ACCOUNT_XPUB=
ETHEREUM_HOT_WALLET_PRIVATE_KEY=
ETHEREUM_USDT_CONTRACT=            # USDT contract address on that chain

# ---------------------------------------------------------------- payments (naira)
PAYMENTS_PROVIDER=Simulated        # Paystack for real naira
PAYSTACK_SECRET_KEY=               # sk_test_… or sk_live_… from the Paystack dashboard

# ---------------------------------------------------------------- identity checks
KYC_PROVIDER=Manual                # Dojah to verify NIN/BVN automatically
DOJAH_APP_ID=
DOJAH_SECRET_KEY=

# ---------------------------------------------------------------- sanctions screening
SANCTIONS_ORACLE_ENABLED=false
SANCTIONS_ORACLE_RPC_URL=          # Ethereum mainnet RPC used to read the sanctions oracle

# ---------------------------------------------------------------- compose
WEB_PATH=../P2P Frontend           # path to the frontend repository checkout
